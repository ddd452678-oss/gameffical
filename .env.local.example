# ─────────────────────────────────────────────────────────────
# 겜피셜 환경 변수 예시
# 이 파일을 복사해서 .env.local 로 저장한 뒤 값을 채우세요.
# 실제 키는 절대 이 파일(.env.local.example)에 넣지 마세요 — git 에 커밋됩니다.
# 실제 키는 .env.local 에만 넣습니다 (.env.local 은 .gitignore 로 제외됨).
# ─────────────────────────────────────────────────────────────

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# anon / publishable 키 (브라우저 노출 OK)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# service_role / secret 키 (서버 전용, 절대 클라이언트·git 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- RAWG API (https://rawg.io/apidocs — 무료 키 발급) ---
RAWG_API_KEY=your_rawg_api_key

# --- Steam Web API (https://steamcommunity.com/dev/apikey — 선택) ---
STEAM_API_KEY=

# 위 키가 하나도 없어도 개발 서버는 뜹니다.
# RAWG_API_KEY 가 없으면 src/lib/sample-games.ts 의 샘플 데이터로 동작합니다.
